# FinSight: empty template only.
# 真实凭据的**默认**存放处是 SQLite 里的 Fernet 密文（data/db/finsight.db，不进版本控制），
# 根密钥只有 FINSIGHT_ENCRYPTION_KEY 一个，放在本机 .env。
# 下面这些 Key 变量**只用于一次显式的“从环境变量导入”动作**，不是常规配置路径。
FINSIGHT_HOST=127.0.0.1
FINSIGHT_PORT=8000
FINSIGHT_FRONTEND_PORT=5173
FINSIGHT_LOG_LEVEL=INFO
HITHINK_FINANCE_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# First-save can explicitly initialize this locally; never print or replace a lost root key.
FINSIGHT_ENCRYPTION_KEY=
# Unattended live validation stays off. A manual UI confirmation authorizes one LLM request.
FINSIGHT_RUN_LIVE_API_TESTS=false
FINSIGHT_RUN_LIVE_LLM_TESTS=false
