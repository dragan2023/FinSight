# ==== 环境与依赖（体积大、可重建，非项目代码）====
.venv/
frontend/node_modules/
.cache/

# ==== 本地密钥（按用户要求不上传；模板见 .env.example）====
.env

# ==== 本机工具状态目录 ====
.dsh-project-memory/

# ==== 字节码与前端构建产物（可重新生成，不入库）====
__pycache__/
*.pyc
*.pyo
frontend/dist/

# ==== 本地行情大数据（约 884 MB，可由 scripts/sync_*.py 重新同步，不入库）====
data/market/

# ==== 运行时产物 ====
logs/*.log
logs/startup.lock

# ==== 本机数据库：含加密凭据密文与业务数据，绝不入库 ====
# 即使只是 Fernet 密文，也按"任何含密钥的文件都不进 git"的红线执行。
data/db/*.db
data/*.db
*.sqlite
*.sqlite3
